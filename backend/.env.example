# Local development (API only — use frontend: npm start on :4200)
PORT=4000
NODE_ENV=local
# CORS_ORIGIN optional in local mode — localhost:4200 and :4000 are added automatically

# Local single-server (http://localhost:4000) — after: npm run build:web:local
# NODE_ENV=local
# SERVE_FRONTEND=true
# CORS_ORIGIN=http://localhost:4000
# Option A: single URL
# DATABASE_URL=mysql://root:root@localhost:3306/green_apple
# Option B: separate fields (recommended on cPanel — no URL encoding issues)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_user
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=your_database
JWT_SECRET=replace-with-a-long-random-secret

# Frontend URL(s) allowed to call the API (comma-separated for www + non-www)
CORS_ORIGIN=http://localhost:4200

# Optional: public API URL if different from how browsers reach /api (usually leave empty on cPanel)
# PUBLIC_API_URL=https://api.yourdomain.com

# PayPal Checkout (https://developer.paypal.com/dashboard/applications)
# PAYPAL_MODE=sandbox
# PAYPAL_CLIENT_ID=your_sandbox_or_live_client_id
# PAYPAL_CLIENT_SECRET=your_sandbox_or_live_secret
# PAYPAL_CURRENCY=EUR

# --- cPanel: Application URL https://greensapples.de (root) — Node serves API + Angular ---
# Do NOT set PORT in .env — cPanel injects PORT; PORT= breaks startup (listen on 0).
# NODE_ENV=production
# MYSQL_HOST=localhost
# MYSQL_USER=cpaneluser_dbuser
# MYSQL_PASSWORD=...
# MYSQL_DATABASE=cpaneluser_green_apple
# JWT_SECRET=your-production-secret
# CORS_ORIGIN=https://greensapples.de,https://www.greensapples.de
# API_ROUTE_PREFIX=/api        (default; omit unless using legacy /api app URL)
# SOCKET_PATH=/socket.io
# FRONTEND_DIST_PATH=public    (default; run npm run build:web before deploy)
